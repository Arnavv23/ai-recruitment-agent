# Copy this file to ".env" and fill in your own values. Never commit ".env".

# --- Security ---
# Long random string used to sign login tokens (32+ characters)
SECRET_KEY=change-me-to-a-long-random-string-of-32-chars-or-more
# First admin account, created automatically on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# --- LLM (any OpenAI-compatible chat-completions API) ---
# Leave LLM_API_KEY empty to run without an LLM (basic fallback answers are used)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Let the LLM help choose the agent tool (true/false)
AGENT_USE_LLM_ROUTER=true

# --- Embeddings / RAG ---
# "sentence-transformers" (real semantic search) or "hash" (offline, no download, used in tests)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Frontend ---
API_URL=http://127.0.0.1:8000
